{
  "name": "Nataal Retail",
  "dataColors": [
    "#0A6BD4",
    "#4CA7F8",
    "#0F1C2E",
    "#1E8449",
    "#E63946",
    "#9AA9BD",
    "#D9A300",
    "#7B61FF",
    "#0852A3",
    "#A9D3FB"
  ],
  "foreground": "#0F1C2E",
  "foregroundNeutralSecondary": "#44566E",
  "foregroundNeutralTertiary": "#64748B",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F8FD",
  "backgroundNeutral": "#DCE6F4",
  "tableAccent": "#0A6BD4",
  "good": "#1E8449",
  "neutral": "#D9A300",
  "bad": "#E63946",
  "maximum": "#0A6BD4",
  "center": "#4CA7F8",
  "minimum": "#E7F0FD",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#0F1C2E"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#0F1C2E"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#0F1C2E"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#44566E"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#EEF4FC" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#EEF4FC" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#DCE6F4" } },
            "radius": 14
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F1C2E" } },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 14,
            "angle": 90,
            "shadowDistance": 3,
            "transparency": 92
          }
        ],
        "padding": [
          {
            "top": 14,
            "bottom": 14,
            "left": 18,
            "right": 18
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F1C2E" } },
            "fontSize": 13,
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#44566E" } },
            "backColor": { "solid": { "color": "#F5F8FD" } },
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#0F1C2E" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#0F1C2E" } },
            "backColorSecondary": { "solid": { "color": "#F9FBFE" } }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E6EDF7" } },
            "outlineColor": { "solid": { "color": "#DCE6F4" } }
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#0F1C2E" } },
            "backColor": { "solid": { "color": "#E7F0FD" } }
          }
        ]
      }
    }
  }
}
