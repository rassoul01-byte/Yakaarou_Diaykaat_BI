# DataFlow360 — variables d'environnement
# Copier ce fichier en .env avant le premier démarrage :  cp .env.example .env
# Le fichier .env n'est JAMAIS versionné. Ce fichier-ci l'est, sans secret réel.

# --- Versions des images ------------------------------------------------
# Épingler des versions précises : « latest » rendrait l'environnement
# différent d'un poste à l'autre. Vérifier les versions stables au moment
# de la mise en place, puis ne plus y toucher sans en informer l'équipe.
POSTGRES_VERSION=16
MONGO_VERSION=7
ES_VERSION=8.15.0
KAFKA_VERSION=3.8.0
AIRFLOW_VERSION=2.10.2

# --- PostgreSQL : entrepôt, schéma intermédiaire, quarantaine -----------
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=changeme_en_local
POSTGRES_DB=dataflow360
POSTGRES_PORT=5432

# --- MongoDB : catalogue produits et avis -------------------------------
MONGO_USER=dataflow
MONGO_PASSWORD=changeme_en_local
MONGO_DB=catalogue
MONGO_PORT=27017

# --- Elasticsearch : index lexical et vectoriel -------------------------
ES_PORT=9200

# --- Kafka : bus d'événements -------------------------------------------
KAFKA_PORT=29092

# --- Airflow : orchestration --------------------------------------------
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=changeme_en_local
AIRFLOW_PORT=8080

# --- Clés d'API (Sprint 5, assistant) -----------------------------------
# Laisser vide ici. Chacun renseigne sa propre clé dans son .env local.
LLM_API_KEY=

DRIVE_OLIST_ID=10FeZJEhyK6YHiChmKDFBTBIIVdKhi8YU
