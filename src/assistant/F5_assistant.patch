+
+
+def test_le_fichier_charge_est_celui_du_contrat():
+    assert FAQ.name == "faq.jsonl" and FAQ.exists()
+
+
+def test_en_dict_garde_tous_les_champs():
+    assert set(Passage("a", "b", "c", "d", "e").en_dict()) == {
